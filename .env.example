# Copy this file to .env, then fill these with unique local values.
DATABASE_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_PORT=8080

# Add your email or contact page. The public Nominatim service allows at most 1 request/second.
GEOCODING_ENABLED=true
GEOCODING_USER_AGENT="Roadwatch/1.0 (contact: replace-with-your-email)"

# Optional: local Ollama vision endpoint. Keep blank to mark reports for human review.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2-vision

# Optional: leave both blank for local filesystem uploads. For deployment, configure a public Supabase bucket.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=roadwatch-images
SUPABASE_SERVICE_KEY=
